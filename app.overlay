#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/esp32-pinctrl.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
    aliases {
        coin-500 = &coin_500;
        coin-1000 = &coin_1000;
        coin-2000 = &coin_2000;
        product-button = &product_button;
        servo-pwm = &servo_pwm;
    };

    buttons {
        compatible = "gpio-keys";

        coin_500: coin_500 {
            gpios = <&gpio0 25 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };

        coin_1000: coin_1000 {
            gpios = <&gpio0 26 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };

        coin_2000: coin_2000 {
            gpios = <&gpio0 27 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };

        product_button: product_button {
            gpios = <&gpio0 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
    };

    pwmleds {
        compatible = "pwm-leds";

        servo_pwm: servo_pwm {
            pwms = <&ledc0 0 20000000 PWM_POLARITY_NORMAL>;
        };
    };
};

/* Konfigurasi I2C LCD */
&pinctrl {
    i2c0_custom: i2c0_custom {
        group1 {
            pinmux = <I2C0_SDA_GPIO21>,
                     <I2C0_SCL_GPIO22>;
            bias-pull-up;
        };
    };

    ledc0_custom: ledc0_custom {
        group1 {
            pinmux = <LEDC_CH0_GPIO19>;
            output-enable;
        };
    };
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;

    pinctrl-0 = <&i2c0_custom>;
    pinctrl-names = "default";
};

/* Konfigurasi PWM ESP32 */
&ledc0 {
    status = "okay";

    pinctrl-0 = <&ledc0_custom>;
    pinctrl-names = "default";

    #address-cells = <1>;
    #size-cells = <0>;

    channel0@0 {
        reg = <0>;
        timer = <0>;
    };
};